# Git Ignore for CoursePilot AI

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Environment and Secrets (NEVER commit secrets!)
.env
.env.local
.env.*.local
*.env
!*.env.example
backend/.env

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
frontend/build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python / Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/build/
backend/develop-eggs/
backend/dist/
backend/downloads/
backend/eggs/
backend/.eggs/
backend/lib/
backend/lib64/
backend/parts/
backend/sdist/
backend/var/
backend/wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/
backend/.venv/
backend/venv/
backend/env/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# User Uploaded Documents & Cache
uploads/
backend/uploads/
sample_data/uploads/
storage/
temp/
*.pdf
!sample_data/sample_syllabus.pdf

# AI Model checkpoints & local cache
.cache/
/models/
huggingface/
sentence_transformers/

# TypeScript composite build artifacts for Vite config
frontend/vite.config.js
frontend/vite.config.d.ts

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

